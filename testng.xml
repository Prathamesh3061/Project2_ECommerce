<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ECommerce Test Suite" verbose="1">

	    <!-- Register our Listener here -->
    <listeners>
        <listener class-name="com.utilities.TestListener"/>
    </listeners>
	
    <test name="Login Tests">
        <classes>
            <class name="com.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Product Tests">
        <classes>
            <class name="com.tests.ProductTest"/>
        </classes>
    </test>

    <test name="Cart Tests">
        <classes>
            <class name="com.tests.CartTest"/>
        </classes>
    </test>

</suite> <!-- Suite -->
